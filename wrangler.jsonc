{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "oh-no-more-snake",
	"main": "src/worker.js",
	"compatibility_date": "2026-08-24",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "oh-no-more-snake.com",
			"custom_domain": true
		},
		{
			"pattern": "www.oh-no-more-snake.com",
			"custom_domain": true
		}
	],

	// The game is static files, so almost everything is served straight from
	// the asset store. The Worker sees /api/* because that is its job, and the
	// page itself so that it can send an http visitor to https — once the
	// document is secure, every relative URL under it is too.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/"]
	},

	// One object per room code, holding the board two players share. Nothing is
	// written to storage — a match lasts exactly as long as its players are
	// connected — but a class still declares which backend it would use.
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOMS",
				"class_name": "VersusRoom"
			}
		]
	},

	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["VersusRoom"]
		}
	],

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "oh-no-more-snake",
			"database_id": "a04a4f45-02fd-4113-a308-77ef7db94db7",
			"migrations_dir": "migrations"
		}
	]
}
