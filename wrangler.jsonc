{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "oh-no-more-snake",
	"main": "src/worker.js",
	"compatibility_date": "2026-08-24",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "oh-no-more-snake.com",
			"custom_domain": true
		},
		{
			"pattern": "www.oh-no-more-snake.com",
			"custom_domain": true
		}
	],

	// The game is static files; only /api/* needs the Worker, so only /api/*
	// reaches it. Everything else is served straight from the asset store.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "oh-no-more-snake",
			"database_id": "a04a4f45-02fd-4113-a308-77ef7db94db7",
			"migrations_dir": "migrations"
		}
	]
}
